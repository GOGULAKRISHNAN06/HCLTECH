********************************************************************************************************************************************************************
4. Vehicle Rental System
Problem Statement

A vehicle rental company rents cars, bikes, and trucks. Each vehicle type has
a different daily rental rate.
Design the program using OOPS structure
********************************************************************************************************************************************************************

import java.util.*;
class Vehicle {
    double dailyRate;
    Vehicle(double dailyRate) {
        this.dailyRate = dailyRate;
    }

    double calculateRentalCharge(int rentalDays) {
        return dailyRate * rentalDays;
    }

    String getVehicleType() {
        return "";
    }
}

class Car extends Vehicle {
    Car() {
        super(1500.0);
    }

    String getVehicleType() {
        return "Car";
    }
}

class Bike extends Vehicle {
    Bike() {
        super(600.0);
    }

    String getVehicleType() {
        return "Bike";
    }
}

class Truck extends Vehicle {
    Truck() {
        super(3000.0);
    }
    String getVehicleType() {
        return "Truck";
    }
}

class Main {
    public static void main(String args[]) {
        Scanner sb = new Scanner(System.in);

        int n = sb.nextInt();
        int rentalDays = sb.nextInt();

        if (n < 1 || n > 3 || rentalDays < 1 || rentalDays > 30) {
            System.out.println("Not Valid");
            return;
        }

        Vehicle v;

        if (n == 1) {
            v = new Car();
        }
        else if (n == 2) {
            v = new Bike();
        }
        else {
            v = new Truck();
        }

        System.out.println("Vehicle Type: " + v.getVehicleType());
        System.out.printf("Rental Charge: %.2f%n", v.calculateRentalCharge(rentalDays));
    }
}
