********************************************************************************************************************************************************************
6. Food Delivery Order
Problem Statement

A food delivery platform provides regular and express delivery services. The
delivery charge and service charge depend on the selected delivery type.
Design the program using OOPS structure
*********************************************************************************************************************************************************************
import java.util.*;
class Delivery {
    double orderAmount;

    Delivery(double orderAmount) {
        this.orderAmount = orderAmount;
    }

    double calculateDeliveryCharge() {
        return 0.0;
    }
}
class RegularDelivery extends Delivery {

    RegularDelivery(double orderAmount) {
        super(orderAmount);
    }

    double calculateDeliveryCharge() {
        double DeliveryCharge = 40.0;
        return orderAmount + DeliveryCharge;
    }
}

class ExpressDelivery extends Delivery {

    ExpressDelivery(double orderAmount) {
        super(orderAmount);
    }

    double calculateDeliveryCharge() {
        double DeliveryCharge = 80.0;
        double ServiceCharge = (5.0 / 100) * orderAmount;

        return orderAmount + DeliveryCharge + ServiceCharge;
    }
}

class Main {
    public static void main(String args[]) {
        Scanner sb = new Scanner(System.in);

        int n = sb.nextInt();
        double orderAmount = sb.nextDouble();

        if (n < 1 || n > 2 || orderAmount <= 0 || orderAmount > 500000) {
            System.out.println("Not Valid");
            return;
        }

        Delivery d;

        if (n == 1) {
            d = new RegularDelivery(orderAmount);
        }
        else {
            d = new ExpressDelivery(orderAmount);
        }

        System.out.printf("%.2f%n", d.calculateDeliveryCharge());
    }
}
