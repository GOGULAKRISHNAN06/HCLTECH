2. Banking Account Management
Problem Statement

A banking application manages different types of accounts. The amount
available to the customer is calculated differently for savings and current
accounts.
Design the program using OOPS structure

*********************************************************************************************************************************************************************
import java.util.*;

abstract class BankAccount {
    private int accountnumber;
    private double balance;

    BankAccount(int accountnumber, double balance) {
        this.accountnumber = accountnumber;
        this.balance = balance;
    }

    public int getAccountnumber(int accountnumber) {
        return accountnumber;
    }

    public double getBalance() {
        return balance;
    }

    abstract double calculateFinalBalance();
}

class SavingAccount extends BankAccount {
    double interestrate;

    SavingAccount(int accountnumber, double balance, double interestrate) {
        super(accountnumber, balance);
        this.interestrate = interestrate;
    }

    double calculateFinalBalance() {
        double ans = getBalance();
        ans = ans + (ans * interestrate / 100);
        return ans;
    }
}

class CurrentAccount extends BankAccount {
    double Overdraft;

    CurrentAccount(int accountnumber, double balance, double Overdraft) {
        super(accountnumber, balance);
        this.Overdraft = Overdraft;
    }

    double calculateFinalBalance() {
        double ans = getBalance();
        ans = ans + Overdraft;
        return ans;
    }
}

class Main {
    public static void main(String args[]) {
        Scanner sb = new Scanner(System.in);

        System.out.println("Enter accountType");
        int n = sb.nextInt();

        if (n == 2) {
            System.out.println("Enter AccountNumber");
            int accountnumber = sb.nextInt();

            if (accountnumber < 1 || accountnumber > 1000000) {
                System.out.println("not valid");
                return;
            }

            System.out.println("Enter Balance");
            double balance = sb.nextDouble();

            if (balance < 0 || balance > 10000000) {
                System.out.println("Balance invalid");
                return;
            }

            System.out.print("Enter interestrate");
            double interestrate = sb.nextDouble();

            if (interestrate < 0.0 || interestrate > 20) {
                System.out.println("not valid");
                return;
            }

            BankAccount account =
                new CurrentAccount(accountnumber, balance, interestrate);

            System.out.printf("%.2f%n", account.calculateFinalBalance());
        }

        else if (n == 1) {
            System.out.println("Enter AccountNumber");
            int accountnumber = sb.nextInt();

            if (accountnumber < 1 || accountnumber > 1000000) {
                System.out.println("not valid");
                return;
            }

            System.out.println("Enter Balance");
            double balance = sb.nextDouble();

            if (balance < 0 || balance > 10000000) {
                System.out.println("Balance invalid");
                return;
            }

            System.out.println("Enter Overdraft");
            double Overdraft = sb.nextDouble();

            if (Overdraft < 0.0 || Overdraft > 5000000) {
                System.out.print("not valid");
                return;
            }

            BankAccount account =
                new SavingAccount(accountnumber, balance, Overdraft);

            System.out.printf("%.2f%n", account.calculateFinalBalance());
        }

        sb.close();
    }
}
